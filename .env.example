# ---- upstream providers (server-side only; callers never see these) --------
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Point at scripts/mock_provider.py for a keyless demo:
# OPENAI_BASE_URL=http://localhost:9100
# ANTHROPIC_BASE_URL=http://localhost:9100

# ---- storage ----------------------------------------------------------------
# default: sqlite file ./events.db (zero infra). Production: Postgres, e.g.
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/costforensics

# ---- semantic cache ----------------------------------------------------------
CACHE_MODE=detect           # detect (default) | serve | off — serve is opt-in, see README
CACHE_TTL_S=300
CACHE_SIMILARITY=0.85
CACHE_MAX_TEMPERATURE=0.3   # only serve cached answers to low-temp requests

# ---- waste windows ------------------------------------------------------------
RETRY_WINDOW_S=60
DUP_WINDOW_S=300

# ---- privacy ------------------------------------------------------------------
# redacted (default): no prompt text stored. full: required for judge_run.py
PROMPT_LOGGING=redacted

# ---- quality-delta judge -------------------------------------------------------
JUDGE_MODEL=claude-sonnet-5
